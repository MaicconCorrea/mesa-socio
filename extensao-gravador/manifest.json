{
  "manifest_version": 3,
  "name": "Outtax — Gravador de reuniões",
  "version": "2.0",
  "description": "Grava o som da aba da reunião (Meet, Zoom, Teams) + seu microfone. A reunião aparece transcrita e resumida no painel do seu setor.",
  "key": "",
  "permissions": [
    "tabCapture",
    "storage",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://mesa-socio.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icone-16.png",
      "48": "icone-48.png",
      "128": "icone-128.png"
    }
  },
  "icons": {
    "16": "icone-16.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  }
}